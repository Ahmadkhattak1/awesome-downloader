{
  "manifest_version": 3,
  "name": "Awesome Downloader Integration",
  "version": "0.1.0",
  "description": "Send links and detected direct video downloads to Awesome Downloader for Windows.",
  "permissions": ["nativeMessaging", "storage", "activeTab", "contextMenus", "webRequest", "downloads", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"scripts": ["hls.js", "youtube-media.js", "background.js"]},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Awesome Downloader", "default_icon":{"16":"icons/icon16.png","32":"icons/icon32.png"}},
  "browser_specific_settings": {"gecko": {"id": "awesome-downloader@morluto.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["media-choices.js", "content.js"], "all_frames": true, "run_at": "document_idle"}]
}
