{
  "name": "awesome-downloader",
  "version": "0.1.0",
  "description": "A Windows and macOS download manager with segmented transfers and browser video capture",
  "main": "desktop/main.cjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahmadkhattak1/awesome-downloader.git"
  },
  "bugs": {
    "url": "https://github.com/Ahmadkhattak1/awesome-downloader/issues"
  },
  "author": "Awesome Downloader contributors",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "test": "tsc && node --test tests/*.test.mjs integration/*.test.cjs extension/*.test.cjs",
    "package": "tsc && electron-builder --win dir",
    "dist": "tsc && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "tsc && electron-builder --win portable --x64 --publish never",
    "package:mac": "tsc && electron-builder --mac dir --arm64",
    "dist:mac": "tsc && electron-builder --mac dmg --arm64 --x64 --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.36.0",
    "@types/node": "22.19.1",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.36.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.31.0",
    "globals": "16.4.0",
    "playwright": "^1.58.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  },
  "build": {
    "appId": "com.awesomedownloader.desktop",
    "productName": "Awesome Downloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "renderer/**/*",
      "assets/**/*",
      "integration/**/*",
      "extension/**/*",
      "THIRD-PARTY.md",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/LICENSE",
        "to": "licenses/ffmpeg-static-LICENSE.txt"
      },
      {
        "from": "node_modules/googlevideo/LICENSE",
        "to": "licenses/googlevideo-LICENSE.txt"
      },
      {
        "from": "vendor",
        "to": "tools",
        "filter": [
          "yt-dlp.exe",
          "yt-dlp",
          "*.txt"
        ]
      },
      {
        "from": "extension",
        "to": "browser/extension",
        "filter": [
          "**/*",
          "!*.test.cjs"
        ]
      },
      {
        "from": "integration",
        "to": "browser/integration",
        "filter": [
          "native-host.exe",
          "native-host.cjs",
          "NativeHostLauncher.cs",
          "README.md",
          "register-native-host.ps1"
        ]
      }
    ],
    "afterPack": "./scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
          "to": "licenses/FFmpeg-LICENSE.txt"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
          "to": "licenses/FFmpeg-BUILD.txt"
        }
      ],
      "asarUnpack": [
        "node_modules/ffmpeg-static/ffmpeg.exe"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE",
          "to": "licenses/FFmpeg-LICENSE.txt"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.README",
          "to": "licenses/FFmpeg-BUILD.txt"
        }
      ],
      "asarUnpack": [
        "node_modules/ffmpeg-static/ffmpeg"
      ]
    },
    "dmg": {
      "artifactName": "Awesome-Downloader-${version}-mac-${arch}.dmg"
    },
    "portable": {
      "artifactName": "Awesome-Downloader-${version}-Windows.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Awesome Downloader",
      "artifactName": "Awesome-Downloader-Setup.exe"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "googlevideo": "^5.0.1"
  },
  "packageManager": "yarn@4.9.2+sha512.1fc009bc09d13cfd0e19efa44cbfc2b9cf6ca61482725eb35bbc5e257e093ebf4130db6dfe15d604ff4b79efd8e1e8e99b25fa7d0a6197c9f9826358d4d65c3c"
}
